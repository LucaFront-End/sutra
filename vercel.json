{
  "rewrites": [
    {
      "source": "/meta-catalog-feed.xml",
      "destination": "/api/catalog-feed?marketplace=meta&format=xml"
    },
    {
      "source": "/meta-catalog-feed.csv",
      "destination": "/api/catalog-feed?marketplace=meta&format=csv"
    },
    {
      "source": "/meta-catalog-feed.tsv",
      "destination": "/api/catalog-feed?marketplace=meta&format=tsv"
    },
    {
      "source": "/google-merchant-feed.tsv",
      "destination": "/api/catalog-feed?marketplace=google&format=tsv"
    },
    {
      "source": "/google-local-inventory-feed.tsv",
      "destination": "/api/catalog-feed?marketplace=google_local&format=tsv"
    },
    {
      "source": "/google-local-inventory-feed.csv",
      "destination": "/api/catalog-feed?marketplace=google_local&format=csv"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
