# ============================================================
# CONFIGURACIÓN SUPABASE — SUTRA MÉXICO
# ============================================================
# Copia este archivo a ".env" y reemplaza con las claves de tu proyecto en Supabase:

# 1. URL de tu proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# 2. Clave anónima pública (Project Settings > API > Project API keys > anon / public)
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# 3. Nombre de la tabla en Supabase donde importaste el CSV (por defecto: sutra_seo_landings)
VITE_SUPABASE_LANDINGS_TABLE=sutra_seo_landings
